
import os
import matplotlib

matplotlib.use("Agg")

import matplotlib.pyplot as plt
import pandas as pd

# Đường dẫn thư mục chứa chương trình
THU_MUC = os.path.dirname(os.path.abspath(__file__))

FILE_SACH = os.path.join(THU_MUC, "sach.csv")
FILE_BIEUDO = os.path.join(THU_MUC, "bieudo.png")
FILE_CANH_BAO = os.path.join(THU_MUC, "canh_bao_sach.csv")

NOI_DUNG_CSV = """MaSach,TenSach,Gia,SoLuong
S001,Lap trinh Python co ban,95000,40
S002,Cau truc du lieu va giai thuat,120000,6
S003,Nhap mon tri tue nhan tao,150000,25
S004,Co so du lieu nang cao,135000,4
S005,Tieng Anh chuyen nganh CNTT,70000,80
"""


# Tao file CSV neu chua ton tai
def tao_file_csv():
    if not os.path.exists(FILE_SACH):
        with open(FILE_SACH, "w", encoding="utf-8-sig") as f:
            f.write(NOI_DUNG_CSV)

        print("Da tao file sach.csv")


# Doc du lieu
def doc_du_lieu():
    df = pd.read_csv(FILE_SACH, encoding="utf-8-sig")

    # Kiem tra cot du lieu
    cot_can_co = ["MaSach", "TenSach", "Gia", "SoLuong"]

    for cot in cot_can_co:
        if cot not in df.columns:
            raise ValueError(f"Thieu cot du lieu: {cot}")

    # Chuyen du lieu ve dang so
    df["Gia"] = pd.to_numeric(df["Gia"], errors="raise")
    df["SoLuong"] = pd.to_numeric(df["SoLuong"], errors="raise")

    if df.empty:
        raise ValueError("File sach.csv khong co du lieu")

    return df


# Thong ke
def thong_ke(df):
    tong_dau_sach = len(df)

    gia_trung_binh = df["Gia"].mean()

    sach_dat_nhat = df.loc[
        df["Gia"].idxmax(), "TenSach"
    ]

    print("\n========== THONG KE ==========")

    print(f"Tong so dau sach: {tong_dau_sach}")

    print(f"Gia trung binh: {gia_trung_binh:,.0f} d")

    print(f"Sach co gia cao nhat: {sach_dat_nhat}")


# Ve bieu do
def ve_bieu_do(df):
    plt.figure(figsize=(10, 6))

    cot = plt.bar(
        df["MaSach"],
        df["SoLuong"],
        color="steelblue"
    )

    plt.bar_label(cot, padding=3)

    plt.title("So luong ton kho cua tung cuon sach")

    plt.xlabel("Ma sach")

    plt.ylabel("So luong")

    plt.grid(axis="y", linestyle="--", alpha=0.3)

    plt.tight_layout()

    plt.savefig(FILE_BIEUDO, dpi=150)

    plt.close()

    print(f"\nDa luu bieu do: {FILE_BIEUDO}")


# Loc sach sap het
def xuat_canh_bao(df):
    sap_het = df[df["SoLuong"] < 10].copy()

    sap_het.to_csv(
        FILE_CANH_BAO,
        index=False,
        encoding="utf-8-sig"
    )

    print("\n========== CANH BAO SACH ==========")

    print(f"So sach sap het: {len(sap_het)}")

    if not sap_het.empty:
        print(sap_het.to_string(index=False))
    else:
        print("Khong co sach sap het")

    print(f"\nDa xuat file: {FILE_CANH_BAO}")


# Chuong trinh chinh
def main():
    try:
        tao_file_csv()

        df = doc_du_lieu()

        thong_ke(df)

        ve_bieu_do(df)

        xuat_canh_bao(df)

        print("\nCHUONG TRINH CHAY THANH CONG!")

    except Exception as e:
        print("\nLOI:", e)


if __name__ == "__main__":
    main()
